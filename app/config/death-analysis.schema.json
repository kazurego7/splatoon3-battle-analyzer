{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["deaths"],
  "properties": {
    "deaths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "situation", "cause", "sequence", "turningPoint", "patternTags"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "situation": { "type": "string", "minLength": 1, "maxLength": 600 },
          "cause": { "type": "string", "minLength": 1, "maxLength": 600 },
          "sequence": {
            "type": "array",
            "minItems": 4,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["offset", "phase", "observation", "interpretation"],
              "properties": {
                "offset": { "type": "number", "enum": [-8, -6, -4, -2, -0.5, 1] },
                "phase": { "type": "string", "enum": ["setup", "approach", "commitment", "danger", "death"] },
                "observation": { "type": "string", "minLength": 1, "maxLength": 300 },
                "interpretation": { "type": "string", "minLength": 1, "maxLength": 300 }
              }
            }
          },
          "turningPoint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["offset", "action", "whyItMattered"],
            "properties": {
              "offset": { "type": "number", "enum": [-8, -6, -4, -2, -0.5, 1] },
              "action": { "type": "string", "minLength": 1, "maxLength": 300 },
              "whyItMattered": { "type": "string", "minLength": 1, "maxLength": 400 }
            }
          },
          "patternTags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "type": "string", "minLength": 1, "maxLength": 60 }
          }
        }
      }
    }
  }
}
